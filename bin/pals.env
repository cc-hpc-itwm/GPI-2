# Started per rank by gaspi_run.pals: maps the PALS rank to the GASPI
# environment. Arguments: machine file, number of ranks (PALS has no such
# variable), NUMA (0/1), program, program arguments.

MFILE="$1"
NRANKS="$2"
SET_NUMA="$3"
PROGRAM="$4"
shift 4

export GASPI_SOCKET="${PALS_LOCAL_RANKID:-0}"
export GASPI_NRANKS="$NRANKS"
export GASPI_RANK="${PALS_RANKID:-0}"
export GASPI_MFILE="$MFILE"
export GASPI_SET_NUMA_SOCKET="$SET_NUMA"

if [ -n "${GASPI_TRACE:-}" ]; then
    export GASPI_TRACE
fi

exec "$PROGRAM" "$@"
